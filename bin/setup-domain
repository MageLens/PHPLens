#!/usr/bin/env bash
# Copyright (c)  MageLens
# SPDX-License-Identifier: Elastic-2.0
# License: see LICENSE in the repository root.

set -euo pipefail
domain=${1:?Missing domain} ca=${2:?Missing project certificate}
[[ -r "$ca" && "$domain" =~ ^[A-Za-z0-9.-]+$ ]] || exit 1
if ! awk -v domain="$domain" '$1 == "127.0.0.1" { for (i=2; i<=NF && $i !~ /^#/; i++) if ($i == domain) found=1 } END { exit !found }' /etc/hosts; then
    printf '127.0.0.1 %s\n' "$domain" | sudo tee -a /etc/hosts >/dev/null
fi
case "$(uname -s)" in
    Darwin)
        if ! security verify-cert -c "$ca" -p basic >/dev/null 2>&1; then
            sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain "$ca"
        fi ;;
    Linux)
        command -v update-ca-certificates >/dev/null || { echo 'Trust the project CA with your distribution tools, or use --container-only.' >&2; exit 1; }
        target="/usr/local/share/ca-certificates/shopware-${COMPOSE_PROJECT_NAME:?}.crt"
        if ! cmp -s "$ca" "$target"; then
            sudo install -m 0644 "$ca" "$target"
            sudo update-ca-certificates
        fi ;;
    *) echo 'Use --container-only on this host.' >&2; exit 1 ;;
esac
