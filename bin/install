#!/usr/bin/env bash
# Copyright (c)  MageLens
# SPDX-License-Identifier: Elastic-2.0
# License: see LICENSE in the repository root.

source "$(dirname "$0")/common"
usage='Usage: ./install.sh [--version 6.7.x.y] [--runner=cypress|playwright] [--container-only] [--project-name NAME] [--domain-id ID] [domain]'
requested_domain='' requested_project='' requested_version='' domain_id='' container_only=0
while (( $# )); do
    case "$1" in
        --help|-h) echo "$usage"; exit 0 ;;
        --container-only) container_only=1 ;;
        --runner=cypress|--runner=playwright) MAGELENS_RUNNER=${1#*=}; export MAGELENS_RUNNER ;;
        --project-name|--domain-id|--version)
            [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || fail "$usage"
            case "$1" in
                --project-name) requested_project=$2 ;;
                --domain-id) domain_id=$2 ;;
                --version) requested_version=$2 ;;
            esac
            shift ;;
        --project-name=?*) requested_project=${1#*=} ;;
        --version=?*) requested_version=${1#*=} ;;
        -*) fail "$usage" ;;
        *) [[ -z "$requested_domain" ]] || fail "$usage"; requested_domain=$1 ;;
    esac
    shift
done
[[ -z "$domain_id" || "$domain_id" =~ ^[0-9a-fA-F]{32}$ ]] || fail '--domain-id takes a 32-character hexadecimal domain ID.'
[[ -z "$requested_version" || "$requested_version" =~ ^v?6\.7\.[0-9]+\.[0-9]+$ ]] || fail '--version takes an exact stable Shopware 6.7 release (for example, 6.7.16.1).'
requested_version=${requested_version#v}
[[ ! -L src && ( ! -e src || -d src ) ]] || fail 'src must be a directory inside this checkout.'
shopt -s dotglob nullglob
source_files=(src/*)
if (( ${#source_files[@]} )); then
    for file in composer.json composer.lock bin/console public/index.php; do
        [[ -f src/$file ]] || fail "Expected a complete Shopware project in src/ (missing $file). Move partial or Magento source to another checkout."
    done
fi
resolve_compose_project "$requested_project"
preflight
verify_compose_project_checkout
lock_workflow
resolve_compose_project "$requested_project"
source_files=(src/*)

# The development image silences PHP errors by default. Send helper diagnostics
# to stderr so state/version reads stay machine-readable.
setup_php=(php -d error_reporting=-1 -d display_errors=stderr -d log_errors=0)
# The source preflight needs PHP but no host runtime, application services or network.
validate_source() {
    docker run --rm --network none -v "$1:/source:ro" -v "$ROOT/docker/shopware:/tools:ro" \
        "$SHOPWARE_IMAGE" "${setup_php[@]}" /tools/check-source.php /source
}
if (( ${#source_files[@]} )); then
    version=$(validate_source "$ROOT/src")
    [[ -z "$requested_version" || "$requested_version" == "$version" ]] ||
        fail "src/composer.lock uses Shopware $version. Use a separate checkout to install Shopware $requested_version."
else
    version=$requested_version
    if [[ -z "$version" ]]; then
        say 'Resolving the latest stable Shopware 6.7 release'
        version=$(docker run --rm -v "$ROOT/docker/shopware:/tools:ro" \
            "$SHOPWARE_IMAGE" "${setup_php[@]}" /tools/latest-version.php) ||
            fail 'Could not resolve the latest stable Shopware 6.7 release. Check access to Packagist or pass an exact --version.'
    fi
fi
compose_settings
touch .env
source "$ROOT/bin/application-domain"
configure_application_domain .env "$requested_domain"
# Persist environment overrides so a later bin/start uses the same public origin.
temp=$(mktemp .env.XXXXXX)
awk '!/^[[:space:]]*(APPLICATION_(HTTPS_)?PORT|RUNNER_VIEW_PORT)[[:space:]]*=/' .env > "$temp"
printf 'APPLICATION_PORT=%s\nAPPLICATION_HTTPS_PORT=%s\nRUNNER_VIEW_PORT=%s\n' "$APPLICATION_PORT" "$APPLICATION_HTTPS_PORT" "$RUNNER_VIEW_PORT" >> "$temp"
mv "$temp" .env
save_compose_project
compose_settings
rm -f .runtime/installed
mkdir -p .runtime/composer .runtime/caddy
printf '%s\n' "$MAGELENS_RUNNER" > .runtime/runner
auth=()
[[ -z ${COMPOSER_AUTH:-} ]] || auth=(-e COMPOSER_AUTH)
cli_version=$(docker run --rm --network none "$SHOPWARE_IMAGE" shopware-cli --version)
[[ "$cli_version" == "shopware-cli version $SHOPWARE_CLI_VERSION" ]] || fail "Expected Shopware CLI $SHOPWARE_CLI_VERSION in the pinned development image."

if (( ! ${#source_files[@]} )); then
    stage=$(mktemp -d "$ROOT/.runtime/create.XXXXXX")
    trap 'rm -rf -- "$stage"; rmdir "$ROOT/.runtime/workflow.lock"' EXIT
    say "Creating Shopware $version"
    docker run --rm --user "$LOCAL_UID:$LOCAL_GID" -e HOME=/tmp -e COMPOSER_HOME=/cache \
        -e DATABASE_URL=mysql://shopware:shopware@db:3306/shopware -e APP_URL="$SHOPWARE_ORIGIN" \
        ${auth[@]+"${auth[@]}"} -v "$ROOT/.runtime/composer:/cache" -v "$stage:/work" -w /work \
        "$SHOPWARE_IMAGE" shopware-cli project create shopware "$version" \
        --no-interaction --docker=false --with-elasticsearch=false --git=false
    scaffold_version=$(validate_source "$stage/shopware")
    [[ "$scaffold_version" == "$version" ]] || fail "Requested Shopware $version, but the scaffold locked $scaffold_version."
    [[ ! -d src ]] || rmdir src
    mv "$stage/shopware" src
fi

say "Preparing local Shopware $version"
dc stop app
dc up -d --wait --wait-timeout 180 db
run_app() { dc run --rm -T --no-deps app "$@"; }
run_composer() {
    dc run --rm -T --no-deps ${auth[@]+"${auth[@]}"} \
        -v "$ROOT/src/composer.lock:/var/www/html/composer.lock:ro" app composer "$@"
}
state=$(run_app "${setup_php[@]}" /tools/database.php state)
if (( ${#source_files[@]} )); then
    run_composer validate --no-check-publish --check-lock --no-interaction
    run_composer install --no-interaction --prefer-dist --no-progress
fi
case "$state" in
    empty)
        options=()
        [[ ! -f src/install.lock ]] || options=(--force)
        run_app php bin/console system:install --basic-setup --skip-first-run-wizard --no-interaction ${options[@]+"${options[@]}"} ;;
    installed) ;;
    *) fail 'Unexpected local database state.' ;;
esac
run_app "${setup_php[@]}" /tools/database.php domains "$(printf '%s' "$domain_id" | tr A-F a-f)"
run_app php bin/console assets:install --no-interaction
run_app php bin/console theme:compile --sync --no-interaction
run_app php bin/console cache:clear --no-interaction
dc up -d --wait app
dc exec -T app "${setup_php[@]}" /tools/ready.php
if (( ! container_only )); then
    "$ROOT/bin/setup-domain" "$APPLICATION_DOMAIN" "$ROOT/.runtime/caddy/caddy/pki/authorities/local/root.crt"
fi
"$ROOT/bin/install-coverage"
printf '%s\n' "$version" > .runtime/installed.tmp
mv .runtime/installed.tmp .runtime/installed
printf 'Storefront  %s/\nAdministration  %s/admin\n' "$SHOPWARE_ORIGIN" "$SHOPWARE_ORIGIN"
if [[ $state == empty ]]; then
    printf 'Username  admin\nPassword  shopware\n'
fi
