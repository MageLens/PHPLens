# Deliberately accept only the documented flat YAML string mapping. No eval,
# shell expansion, host YAML package, or bootstrapping container is needed.
load_dependencies() {
    local file=$1 line key value seen=' ' number=0 required
    local double='^([A-Z][A-Z0-9_]*):[[:space:]]+"([a-zA-Z0-9_./:@+-]+)"[[:space:]]*(#.*)?$'
    local single="^([A-Z][A-Z0-9_]*):[[:space:]]+'([a-zA-Z0-9_./:@+-]+)'[[:space:]]*(#.*)?$"
    [[ -f "$file" ]] || { printf 'Missing dependency configuration: %s\n' "$file" >&2; return 1; }
    while IFS= read -r line || [[ -n "$line" ]]; do
        number=$((number + 1))
        line=${line%$'\r'}
        [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        if [[ "$line" =~ $double || "$line" =~ $single ]]; then
            key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
        else
            printf '%s:%s: expected KEY: "value" (a flat YAML string mapping).\n' "$file" "$number" >&2
            return 1
        fi
        case "$key" in
            SHOPWARE_CLI_VERSION) [[ "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1 ;;
            SHOPWARE_IMAGE|DATABASE_IMAGE) [[ "$value" =~ @sha256:[a-f0-9]{64}$ ]] || return 1 ;;
            CHROME_VERSION) [[ "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1 ;;
            CHROME_LINUX_X64_SHA256) [[ "$value" =~ ^[a-f0-9]{64}$ ]] || return 1 ;;
            *) printf '%s: unknown dependency key %s.\n' "$file" "$key" >&2; return 1 ;;
        esac
        [[ "$seen" != *" $key "* ]] || { printf '%s: duplicate key %s.\n' "$file" "$key" >&2; return 1; }
        seen+="$key "
        export "$key=$value"
    done < "$file"
    for required in SHOPWARE_CLI_VERSION SHOPWARE_IMAGE DATABASE_IMAGE CHROME_VERSION CHROME_LINUX_X64_SHA256; do
        [[ "$seen" == *" $required "* ]] || { printf '%s: missing dependency %s.\n' "$file" "$required" >&2; return 1; }
    done
}
