resolve_compose_project() {
    local requested=${1:-} saved='' recorded='' selected fallback=shopware LC_ALL=C
    if [[ -f "$ROOT/.env" ]]; then
        # Read a literal dotenv value without executing shell code.
        saved=$(sed -n 's/^[[:space:]]*COMPOSE_PROJECT_NAME[[:space:]]*=[[:space:]]*//p' "$ROOT/.env" | tail -n 1)
        saved=${saved%$'\r'}
        saved=$(printf '%s' "$saved" | sed 's/[[:space:]]#.*$//;s/[[:space:]]*$//')
        saved=${saved#\"}; saved=${saved%\"}
        saved=${saved#\'}; saved=${saved%\'}
    fi
    if [[ -f "$ROOT/.runtime/compose-project-name" ]]; then
        recorded=$(cat "$ROOT/.runtime/compose-project-name")
    fi
    selected=${requested:-${COMPOSE_PROJECT_NAME:-${saved:-$fallback}}}
    if [[ ! "$selected" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
        printf 'Invalid Compose project name. Use lowercase letters, digits, hyphens or underscores, starting with a lowercase letter or digit (for example: --project-name client-shop).\n' >&2
        return 1
    fi
    if [[ -n "$recorded" && "$selected" != "$recorded" ]]; then
        printf 'This installation uses Compose project "%s"; refusing to switch to "%s" and different database volumes. Keep COMPOSE_PROJECT_NAME=%s in .env and unset conflicting environment overrides. To use another project name, install in a separate directory with its own domain and ports.\n' "$recorded" "$selected" "$recorded" >&2
        return 1
    fi
    export COMPOSE_PROJECT_NAME="$selected"
}

resolve_compose_command_project() {
    local requested=''
    # Check Compose's own project flags too, before the service command/arguments.
    while (( $# )); do
        case "$1" in
            -p|--project-name)
                [[ $# -gt 1 && -n "$2" && "$2" != -* ]] || { printf 'Compose --project-name requires a name.\n' >&2; return 1; }
                requested=$2; shift ;;
            --project-name=*)
                requested=${1#*=}
                [[ -n "$requested" ]] || { printf 'Compose --project-name requires a name.\n' >&2; return 1; } ;;
            -p?*) requested=${1#-p} ;;
            --ansi|--env-file|-f|--file|--parallel|--profile|--progress|--project-directory)
                [[ $# -gt 1 ]] || return 1
                shift ;;
            -*) ;;
            *) break ;;
        esac
        shift
    done
    resolve_compose_project "$requested" || return 1
    # Rendering configuration does not access the project's containers.
    case "${1:-}" in config|version) return 0 ;; esac
    verify_compose_project_checkout || return 1
    case "${1:-}" in
        up|run|create)
            # Docker creates a named volume atomically. Re-read the winner's label
            # before Compose can attach a database during concurrent first installs.
            local volume="${COMPOSE_PROJECT_NAME}_dbdata" owner
            docker volume create --label "io.shopwarelens.checkout=$SHOPWARE_CHECKOUT" \
                --label "com.docker.compose.project=$COMPOSE_PROJECT_NAME" \
                --label com.docker.compose.volume=dbdata "$volume" >/dev/null || return 1
            owner=$(docker volume inspect -f '{{index .Labels "io.shopwarelens.checkout"}}' "$volume") || return 1
            [[ "$owner" == "$SHOPWARE_CHECKOUT" ]] || { printf 'Database volume %s belongs to another checkout.\n' "$volume" >&2; return 1; } ;;
    esac
}

verify_compose_project_checkout() {
    local containers service directory checkout
    checkout=$(cd "$ROOT" && pwd -P) || return 1
    containers=$(docker ps -a --filter "label=com.docker.compose.project=$COMPOSE_PROJECT_NAME" \
        --format '{{.Label "com.docker.compose.service"}}\t{{.Label "com.docker.compose.project.working_dir"}}') || return 1
    while IFS=$'\t' read -r service directory; do
        [[ -n "$service" ]] || continue
        if [[ -d "$directory" ]]; then
            directory=$(cd "$directory" && pwd -P) || return 1
        fi
        if [[ "$directory" != "$checkout" ]]; then
            printf 'Compose project "%s" has %s containers from another checkout: %s\nCurrent checkout: %s\nRun commands from the owning checkout. Use a separate Docker project, domain and ports for a separate installation; do not change the project name of an existing database.\n' \
                "$COMPOSE_PROJECT_NAME" "$service" "${directory:-unknown directory}" "$checkout" >&2
            return 1
        fi
    done <<< "$containers"
    local volumes volume owner
    volumes=$(docker volume ls --format '{{.Name}}' --filter "name=^${COMPOSE_PROJECT_NAME}_dbdata$") || return 1
    for volume in $volumes; do
        owner=$(docker volume inspect -f '{{index .Labels "io.shopwarelens.checkout"}}' "$volume") || return 1
        [[ "$owner" == "$checkout" ]] || { printf 'Database volume %s belongs to another checkout. Choose a separate project name.\n' "$volume" >&2; return 1; }
    done
}

save_compose_project() {
    local temporary
    temporary=$(mktemp "$ROOT/.env.XXXXXX") || return 1
    if ! cp -p "$ROOT/.env" "$temporary" || ! awk -v project="$COMPOSE_PROJECT_NAME" '
        /^[[:space:]]*COMPOSE_PROJECT_NAME[[:space:]]*=/ { next }
        { print }
        END { print "COMPOSE_PROJECT_NAME=" project }
    ' "$ROOT/.env" > "$temporary" || ! mv "$temporary" "$ROOT/.env"; then
        rm -f "$temporary"
        return 1
    fi
    # Pin before creating volumes, including when installation is interrupted.
    printf '%s\n' "$COMPOSE_PROJECT_NAME" > "$ROOT/.runtime/compose-project-name"
}
