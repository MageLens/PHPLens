set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"
source "$ROOT/bin/dependencies"
load_dependencies "$ROOT/dependencies.yaml"
export LOCAL_UID=$(id -u) LOCAL_GID=$(id -g)
source "$ROOT/bin/compose-project"
export SHOPWARE_CHECKOUT=$(pwd -P)
MAGELENS_RUNNER=${MAGELENS_RUNNER:-$(cat .runtime/runner 2>/dev/null || printf cypress)}
[[ "$MAGELENS_RUNNER" == cypress || "$MAGELENS_RUNNER" == playwright ]] || { printf 'Invalid saved runner selection.\n' >&2; exit 1; }
export MAGELENS_RUNNER

# Match the installer's literal dotenv format without sourcing application secrets.
local_setting() {
    local key=$1 fallback=$2 value=${!1:-}
    if [[ -z "$value" && -f .env ]]; then
        value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" .env | tail -n 1)
        value=${value%$'\r'}
        value=${value%% #*}
        value=${value#\"}; value=${value%\"}
        value=${value#\'}; value=${value%\'}
    fi
    printf '%s' "${value:-$fallback}"
}

compose_settings() {
    APPLICATION_DOMAIN=$(local_setting APPLICATION_DOMAIN shopware.test)
    APPLICATION_PORT=$(local_setting APPLICATION_PORT 80)
    APPLICATION_HTTPS_PORT=$(local_setting APPLICATION_HTTPS_PORT 443)
    local port
    for port in "$APPLICATION_PORT" "$APPLICATION_HTTPS_PORT"; do
        [[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )) || fail 'Application ports must be integers between 1 and 65535.'
    done
    [[ "$APPLICATION_PORT" != "$APPLICATION_HTTPS_PORT" ]] || fail 'HTTP and HTTPS ports must differ.'
    SHOPWARE_ORIGIN="https://$APPLICATION_DOMAIN"
    [[ "$APPLICATION_HTTPS_PORT" == 443 ]] || SHOPWARE_ORIGIN+=":$APPLICATION_HTTPS_PORT"
    RUNNER_VIEW_PORT=$(local_setting RUNNER_VIEW_PORT 6080)
    [[ "$RUNNER_VIEW_PORT" =~ ^[1-9][0-9]{0,4}$ ]] && (( RUNNER_VIEW_PORT <= 65535 )) || fail 'Invalid RUNNER_VIEW_PORT.'
    [[ "$RUNNER_VIEW_PORT" != "$APPLICATION_PORT" && "$RUNNER_VIEW_PORT" != "$APPLICATION_HTTPS_PORT" ]] || fail 'Viewer and application ports must differ.'
    export RUNNER_VIEW_PORT SHOPWARE_ORIGIN APPLICATION_DOMAIN APPLICATION_PORT APPLICATION_HTTPS_PORT
}

app_exec() {
    local flags=()
    [[ -t 0 && -t 1 ]] || flags+=(-T)
    [[ ${1:-} != composer || -z ${COMPOSER_AUTH:-} ]] || flags+=(-e COMPOSER_AUTH)
    dc exec ${flags[@]+"${flags[@]}"} app "$@"
}

dc() {
    compose_settings
    resolve_compose_command_project "$@" || return 1
    docker compose --project-directory "$ROOT" -f "$ROOT/compose.yaml" --profile coverage "$@"
}

coverage_dc() {
    compose_settings
    resolve_compose_command_project "$@" || return 1
    docker compose --project-directory "$ROOT" -f "$ROOT/compose.yaml" -f "$ROOT/compose.coverage.yaml" --profile coverage "$@"
}

coverage_fingerprint() {
    cksum dependencies.yaml package.json package-lock.json compose.coverage.yaml docker/shopware/coverage.Dockerfile docker/shopware/coverage.ini docker/php/composer.json docker/php/composer.lock docker/runner/Dockerfile docker/runner/*.sh docker/runner/*.cjs docker/runner/cypress-source/* | cksum | awk '{print $1 "-" $2}'
}

say() { printf '\n==> %s\n' "$*"; }
fail() { printf '\nError: %s\n' "$*" >&2; exit 1; }
preflight() {
    command -v docker >/dev/null || fail 'Install Docker with Compose v2.24.4 or newer, then rerun ./install.sh.'
    docker info >/dev/null 2>&1 || fail 'Docker is unavailable. Start Docker and ensure your user can run docker info.'
    local version
    version=$(docker compose version --short | sed 's/^v//')
    [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]] || fail 'Cannot determine Docker Compose version.'
    (( BASH_REMATCH[1] > 2 || (BASH_REMATCH[1] == 2 && (BASH_REMATCH[2] > 24 || (BASH_REMATCH[2] == 24 && BASH_REMATCH[3] >= 4))) )) || fail 'Docker Compose v2.24.4+ is required for Shopware services.'
}
lock_workflow() {
    mkdir -p .runtime
    mkdir .runtime/workflow.lock 2>/dev/null || fail 'Another installation is active. If interrupted, remove .runtime/workflow.lock after checking Docker.'
    trap 'rmdir "$ROOT/.runtime/workflow.lock"' EXIT
}
