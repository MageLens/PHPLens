source "$(dirname "$0")/common"
if [[ $# == 0 || "${1:-}" == --help || "${1:-}" == -h ]]; then
    printf 'Usage: ./bin/runner COMMAND [arguments...]\nRun a command in the installed browser runner. Start services with ./bin/start.\n'
    exit 0
fi
flags=()
[[ -t 0 && -t 1 ]] || flags+=(-T)
dc exec ${flags[@]+"${flags[@]}"} runner "$@"
